---
import '../styles/global.css';
import { User, Mail, Phone, Lock, ArrowRight, CheckCircle2, ChevronLeft } from '@lucide/astro';

// Get paket parameter from URL if any
const { searchParams } = Astro.url;
const paketId = searchParams.get('paket');
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Daftar Akun Jamaah | PaKeM Tours</title>
  <meta name="description" content="Daftar akun baru untuk mengakses layanan dan informasi pendaftaran jamaah PaKeM Tours." />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
  </style>
</head>
<body class="antialiased min-h-screen flex flex-col justify-center relative overflow-x-hidden text-slate-600 selection:bg-[#c39336]/30 selection:text-white bg-[#0a1930] py-8 md:py-12">

  <!-- Premium Background Accents -->
  <div class="absolute top-0 right-0 w-full h-full bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-[#c39336]/20 via-[#0a1930] to-[#0a1930] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-[#c39336]/10 blur-[150px] rounded-full pointer-events-none"></div>

  <div class="container mx-auto px-4 w-full max-w-md relative z-10 py-10">
    
    <!-- Back Button -->
    <a href="javascript:history.back()" class="inline-flex items-center gap-2 text-white/80 hover:text-[#c39336] transition-colors mb-6 text-sm font-semibold group">
      <div class="w-8 h-8 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center group-hover:bg-[#c39336]/20 border border-white/10 transition-all">
        <ChevronLeft class="w-4 h-4" />
      </div>
      Kembali
    </a>

    <!-- Main Form Card -->
    <div class="bg-white rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.5)] p-6 sm:p-10 relative overflow-hidden border border-white/20">
      
      <!-- Top Accent Line -->
      <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-[#c39336] to-[#e8c05d]"></div>
      
      <!-- Logo/Header -->
      <div class="text-center mb-8">
        <a href="/" class="inline-block mb-5">
          <img src="/images/logo-pakem.png" alt="PaKeM Tours Logo" class="h-12 w-auto mx-auto" />
        </a>
        <h1 class="text-2xl sm:text-3xl font-black text-[#0a1930] mb-2 tracking-tight">Daftar Akun</h1>
        <p class="text-sm text-slate-500 leading-relaxed px-4">Bergabung bersama PaKeM Tours untuk perjalanan ibadah yang bermakna.</p>
      </div>
      
      <!-- Success State (Hidden by default) -->
      <div id="successState" class="hidden text-center py-6">
        <div class="w-20 h-20 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-6 shadow-inner">
          <CheckCircle2 class="w-10 h-10 text-green-500" />
        </div>
        <h2 class="text-xl font-bold text-[#0a1930] mb-2">Registrasi Berhasil!</h2>
        <p class="text-sm text-slate-500 mb-8">Akun Anda telah berhasil dibuat. Anda akan diarahkan ke halaman login dalam 3 detik...</p>
        <a href="http://127.0.0.1:8000/login" class="inline-block w-full py-3.5 bg-gradient-to-r from-[#0a1930] to-[#0f2445] text-white font-bold rounded-xl hover:shadow-lg transition-all">
          Lanjut Login Sekarang
        </a>
      </div>

      <!-- Form Form -->
      <form id="registerForm" class="space-y-4">
        <!-- Hidden Input for Paket ID if any -->
        {paketId && <input type="hidden" name="paket_id" value={paketId} />}
        
        <div id="globalError" class="hidden bg-red-50 text-red-600 p-3 rounded-xl text-xs font-medium border border-red-100 mb-4 text-center"></div>

        <!-- Nama -->
        <div>
          <label class="block text-[11px] font-bold text-slate-700 mb-1.5 ml-1 uppercase tracking-wider">Nama Lengkap</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
              <User class="w-4 h-4" />
            </div>
            <input type="text" name="name" required class="w-full pl-11 pr-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#0a1930]/10 focus:border-[#0a1930] outline-none transition-all placeholder:text-slate-400 text-slate-900 font-medium shadow-sm" placeholder="Sesuai identitas KTP" />
          </div>
          <p class="error-msg text-red-500 text-[10px] mt-1 hidden ml-1 font-medium" data-for="name"></p>
        </div>

        <!-- Email -->
        <div>
          <label class="block text-[11px] font-bold text-slate-700 mb-1.5 ml-1 uppercase tracking-wider">Email Aktif</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
              <Mail class="w-4 h-4" />
            </div>
            <input type="email" name="email" required class="w-full pl-11 pr-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#0a1930]/10 focus:border-[#0a1930] outline-none transition-all placeholder:text-slate-400 text-slate-900 font-medium shadow-sm" placeholder="nama@email.com" />
          </div>
          <p class="error-msg text-red-500 text-[10px] mt-1 hidden ml-1 font-medium" data-for="email"></p>
        </div>

        <!-- No WA -->
        <div>
          <label class="block text-[11px] font-bold text-slate-700 mb-1.5 ml-1 uppercase tracking-wider">No. WhatsApp</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
              <Phone class="w-4 h-4" />
            </div>
            <input type="tel" name="phone_wa" required class="w-full pl-11 pr-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#0a1930]/10 focus:border-[#0a1930] outline-none transition-all placeholder:text-slate-400 text-slate-900 font-medium shadow-sm" placeholder="081234567890" />
          </div>
          <p class="error-msg text-red-500 text-[10px] mt-1 hidden ml-1 font-medium" data-for="phone_wa"></p>
        </div>

        <!-- Password -->
        <div>
          <label class="block text-[11px] font-bold text-slate-700 mb-1.5 ml-1 uppercase tracking-wider">Password</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
              <Lock class="w-4 h-4" />
            </div>
            <input type="password" name="password" required class="w-full pl-11 pr-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#0a1930]/10 focus:border-[#0a1930] outline-none transition-all placeholder:text-slate-400 text-slate-900 font-medium shadow-sm" placeholder="Minimal 8 karakter" />
          </div>
          <p class="error-msg text-red-500 text-[10px] mt-1 hidden ml-1 font-medium" data-for="password"></p>
        </div>

        <!-- Konfirmasi Password -->
        <div>
          <label class="block text-[11px] font-bold text-slate-700 mb-1.5 ml-1 uppercase tracking-wider">Konfirmasi Password</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
              <Lock class="w-4 h-4" />
            </div>
            <input type="password" name="password_confirmation" required class="w-full pl-11 pr-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#0a1930]/10 focus:border-[#0a1930] outline-none transition-all placeholder:text-slate-400 text-slate-900 font-medium shadow-sm" placeholder="Ketik ulang password" />
          </div>
        </div>

        <div class="pt-6">
          <button type="submit" id="submitBtn" class="w-full flex items-center justify-center gap-2 py-3.5 px-6 bg-gradient-to-r from-[#c39336] to-[#e8c05d] hover:from-[#e8c05d] hover:to-[#c39336] text-[#0a1930] font-black rounded-xl shadow-[0_8px_20px_rgba(195,147,54,0.3)] hover:shadow-[0_10px_25px_rgba(195,147,54,0.4)] transition-all hover:-translate-y-0.5 disabled:opacity-70 disabled:cursor-not-allowed disabled:transform-none">
            <span>Daftar Sekarang</span>
            <ArrowRight class="w-4 h-4" />
          </button>
        </div>
        
        <div class="text-center pt-4">
          <p class="text-xs text-slate-500 font-medium">Sudah punya akun? <a href="http://127.0.0.1:8000/login" class="text-[#c39336] font-bold hover:underline">Masuk di sini</a></p>
        </div>
      </form>

    </div>
  </div>

  <script>
    // Client-side script to handle form submission via API
    const form = document.getElementById('registerForm') as HTMLFormElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const successState = document.getElementById('successState');
    const globalError = document.getElementById('globalError');
    const errorMsgs = document.querySelectorAll('.error-msg');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Reset errors & states
        if(globalError) {
          globalError.classList.add('hidden');
          globalError.textContent = '';
        }
        errorMsgs.forEach(el => {
          el.textContent = '';
          el.classList.add('hidden');
        });

        // Show loading
        const originalBtnContent = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-[#0a1930]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span class="text-sm">Memproses...</span>
        `;

        try {
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());

          const response = await fetch('http://127.0.0.1:8000/api/register', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (response.ok || response.status === 201) {
            // Success
            form.classList.add('hidden');
            if(successState) successState.classList.remove('hidden');
            
            // Redirect to login after 3 seconds
            setTimeout(() => {
              window.location.href = 'http://127.0.0.1:8000/login';
            }, 3000);
            
          } else if (response.status === 422) {
            // Validation Error
            const errors = result.errors;
            if (errors) {
              Object.keys(errors).forEach(key => {
                const errorEl = document.querySelector(`.error-msg[data-for="${key}"]`);
                if (errorEl) {
                  errorEl.textContent = errors[key][0];
                  errorEl.classList.remove('hidden');
                }
              });
            } else {
              if(globalError) {
                globalError.textContent = result.message || 'Terjadi kesalahan validasi.';
                globalError.classList.remove('hidden');
              }
            }
          } else {
            // Other Error
            if(globalError) {
              globalError.textContent = result.message || 'Terjadi kesalahan pada server. Silakan coba lagi nanti.';
              globalError.classList.remove('hidden');
            }
          }
        } catch (error) {
          console.error('Error during registration:', error);
          if(globalError) {
            globalError.textContent = 'Gagal terhubung ke server. Pastikan koneksi internet Anda stabil.';
            globalError.classList.remove('hidden');
          }
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnContent;
        }
      });
    }
  </script>
</body>
</html>
