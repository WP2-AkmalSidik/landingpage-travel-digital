---
import MainLayout from '../layouts/MainLayout.astro';
import { Calculator, Wallet, CalendarDays, ShieldCheck, Clock, PiggyBank, HandHeart, CheckCircle2, ChevronDown, Play } from '@lucide/astro';

const faqs = [
  {
    q: "Apakah dana tabungan saya aman?",
    a: "Sangat aman. Dana tabungan Anda disimpan di rekening Virtual Account khusus jamaah yang bekerjasama dengan Bank Syariah Nasional, bukan di rekening operasional travel. Dana tersebut hanya bisa digunakan untuk pembayaran paket keberangkatan Anda sendiri."
  },
  {
    q: "Berapa minimal setoran per bulan?",
    a: "Kami memberikan fleksibilitas penuh. Anda bisa mulai menabung dari Rp 500.000 per bulan, tanpa denda jika ada bulan yang terlewat. Sistem kami menyesuaikan dengan kondisi finansial Anda."
  },
  {
    q: "Apakah harga paket mengikat saat saya mulai menabung?",
    a: "Harga paket umrah/haji bersifat fluktuatif mengikuti kurs mata uang, tiket pesawat, dan kebijakan pemerintah Arab Saudi. Harga final adalah harga pada saat Anda menentukan jadwal keberangkatan (dana sudah mencukupi)."
  },
  {
    q: "Bagaimana jika saya batal berangkat dan ingin menarik dana?",
    a: "Dana dapat ditarik kembali 100% tanpa potongan (jika belum didaftarkan tiket/visa/hotel). Anda cukup mengajukan form penarikan dana dan prosesnya akan memakan waktu 3-7 hari kerja."
  }
];

const benefits = [
  {
    icon: ShieldCheck,
    title: "100% Aman & Terjamin",
    desc: "Dana dikelola oleh Bank Syariah Rekanan, bukan di rekening travel. Bebas dari penyelewengan."
  },
  {
    icon: PiggyBank,
    title: "Fleksibel Tanpa Beban",
    desc: "Setoran suka-suka sesuai kemampuan. Tanpa sistem denda jika absen setor di bulan tertentu."
  },
  {
    icon: HandHeart,
    title: "Sesuai Syariah (Bebas Riba)",
    desc: "Sistem tabungan wadiah murni tanpa bunga, menjaga keberkahan niat suci Anda ke Baitullah."
  },
  {
    icon: Clock,
    title: "Prioritas Keberangkatan",
    desc: "Jamaah tabungan mendapatkan prioritas seat (*kursi*) pada saat dana telah mencapai target."
  }
];
---

<MainLayout title="Simulasi Tabungan Umrah & Haji | PaKeM Tours" description="Rencanakan ibadah ke tanah suci dengan sistem tabungan yang aman, fleksibel, dan transparan bersama PaKeM Tours.">
  
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center pt-24 pb-12 overflow-hidden bg-[#0a1930]">
    <div class="absolute inset-0 z-0">
      <div class="absolute top-0 right-0 w-full h-full bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-gold/20 via-[#0a1930] to-[#0a1930] pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-1/2 h-1/2 bg-blue-900/30 blur-[120px] rounded-full pointer-events-none"></div>
    </div>
    
    <div class="container mx-auto px-4 max-w-7xl relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
        
        <!-- Left: Copy -->
        <div class="text-white animate-fade-in-up">
          <div>
            <div class="inline-block px-4 py-1.5 rounded-full bg-white/10 backdrop-blur border border-white/20 text-gold text-sm font-bold uppercase tracking-widest mb-6 shadow-xl">
              Program Tabungan
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-black mb-6 leading-[1.15] tracking-tight">
              Wujudkan Niat Suci <br class="hidden md:block"/> Dengan <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold to-gold-light">Langkah Kecil</span>
            </h1>
            <p class="text-lg text-neutral-300 max-w-xl leading-relaxed">
              Tidak perlu menunggu kaya untuk bisa berangkat ke Baitullah. Mulai dari niat, rutinkan menabung, dan biarkan sistem kami mengamankan kursi Anda.
            </p>
          </div>
        </div>
        
        <!-- Right: Simulation Calculator -->
        <div class="lg:justify-self-end w-full max-w-lg animate-fade-in-up" style="animation-delay: 200ms;">
          <div class="bg-white rounded-[2.5rem] shadow-[0_20px_60px_rgba(0,0,0,0.4)] p-6 sm:p-8 relative overflow-hidden border border-white/20">
            <!-- Accent Top -->
            <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-gold to-gold-light"></div>
            
            <div class="flex items-center gap-3 mb-8">
              <div class="w-12 h-12 rounded-2xl bg-[#0a1930]/5 text-[#0a1930] flex items-center justify-center shrink-0">
                <Calculator class="w-6 h-6" />
              </div>
              <div>
                <h3 class="text-xl font-bold text-[#0a1930]">Kalkulator Simulasi</h3>
                <p class="text-xs text-slate-500">Hitung estimasi keberangkatan Anda</p>
              </div>
            </div>
            
            <form id="simulasiForm" class="space-y-5">
              
              <!-- Pilihan Target Paket -->
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-2 uppercase tracking-wider">Target Paket</label>
                <select id="paket_target" class="w-full px-4 py-4 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 font-bold shadow-sm cursor-pointer">
                  <option value="28500000">Umrah Reguler (± Rp 28.5 Juta)</option>
                  <option value="35000000">Umrah Plus (± Rp 35 Juta)</option>
                  <option value="200000000">Haji Khusus (± Rp 200 Juta)</option>
                </select>
              </div>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <!-- Jumlah Jamaah -->
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-2 uppercase tracking-wider">Jml Jamaah</label>
                  <select id="jumlah_jamaah" class="w-full px-4 py-4 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 font-bold shadow-sm cursor-pointer">
                    {[1,2,3,4,5,6].map(num => (
                      <option value={num}>{num} Orang</option>
                    ))}
                  </select>
                </div>
                
                <!-- Kemampuan Setoran -->
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-2 uppercase tracking-wider">Setoran /Bulan</label>
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-500 font-bold text-sm">
                      Rp
                    </div>
                    <input type="text" id="setoran_perbulan" class="w-full pl-12 pr-4 py-4 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 font-bold shadow-sm placeholder:font-normal placeholder:text-slate-400" value="1.000.000" placeholder="1.000.000" />
                  </div>
                </div>
              </div>

              <!-- Button Hitung -->
              <div class="pt-6">
                <button type="button" id="btnHitung" class="w-full py-4 bg-gradient-to-r from-[#0a1930] to-[#0f2445] hover:shadow-xl hover:-translate-y-0.5 text-gold font-bold rounded-xl shadow-lg transition-all active:scale-95 flex justify-center items-center gap-2">
                  <span>Hitung Estimasi</span>
                </button>
              </div>

            </form>
            
            <!-- Result Area -->
            <div id="resultArea" class="mt-6 pt-6 border-t border-slate-100 hidden">
              <div class="bg-[#f8f9fa] rounded-2xl p-5 border border-slate-200 shadow-inner">
                <div class="flex items-center gap-2 text-green-600 font-bold mb-4">
                  <CheckCircle2 class="w-5 h-5" /> Hasil Simulasi
                </div>
                
                <div class="space-y-4">
                  <div class="flex justify-between items-center">
                    <span class="text-sm text-slate-500">Total Kebutuhan Dana</span>
                    <span class="font-bold text-slate-900" id="resTotal">Rp 0</span>
                  </div>
                  
                  <div class="flex justify-between items-center">
                    <span class="text-sm text-slate-500">Estimasi Lama Menabung</span>
                    <div class="flex items-center gap-1.5 font-bold text-slate-900">
                      <Clock class="w-4 h-4 text-gold" /> <span id="resDurasi">0 Bulan</span>
                    </div>
                  </div>
                  
                  <div class="flex justify-between items-center pt-3 border-t border-slate-200">
                    <span class="text-sm font-bold text-[#0a1930]">Prediksi Keberangkatan</span>
                    <div class="flex items-center gap-1.5 font-black text-xl text-gold">
                      <CalendarDays class="w-5 h-5" /> <span id="resTahun">202x</span>
                    </div>
                  </div>
                </div>
                
                <a href="/register" class="mt-6 block w-full py-3 bg-gradient-to-r from-gold to-gold-light text-[#0a1930] text-center font-bold rounded-xl hover:shadow-lg transition-shadow">
                  Mulai Buka Rekening
                </a>
              </div>
            </div>
            
          </div>
        </div>
        
      </div>
    </div>
  </section>

  <!-- Keuntungan Section -->
  <section class="py-20 bg-neutral-50 relative">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-black text-[#0a1930] mb-4">Mengapa Memilih Tabungan PaKeM?</h2>
        <p class="text-slate-500">Kami menjamin keamanan dan kenyamanan Anda dalam mempersiapkan dana perjalanan suci.</p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {benefits.map((b, i) => (
          <div class="bg-white p-8 rounded-[2rem] shadow-sm border border-neutral-100 hover:shadow-xl hover:-translate-y-1 transition-all group">
            <div class="w-14 h-14 rounded-2xl bg-[#0a1930]/5 text-[#0a1930] flex items-center justify-center mb-6 group-hover:bg-gold group-hover:text-white transition-colors duration-300">
              <b.icon class="w-7 h-7" />
            </div>
            <h3 class="font-bold text-lg text-slate-900 mb-3">{b.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 max-w-3xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-black text-[#0a1930] mb-4">Pertanyaan Seputar Tabungan</h2>
        <p class="text-slate-500">Temukan jawaban untuk keraguan Anda tentang sistem tabungan kami.</p>
      </div>
      
      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <div class="faq-item border border-neutral-200 rounded-2xl overflow-hidden bg-white transition-all duration-300">
            <button class="faq-btn w-full text-left px-6 py-5 flex justify-between items-center focus:outline-none group">
              <span class="font-bold text-slate-900 group-hover:text-gold transition-colors">{faq.q}</span>
              <ChevronDown class="w-5 h-5 text-slate-400 faq-icon transition-transform duration-300" />
            </button>
            <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300 px-6">
              <p class="text-slate-500 pb-5 leading-relaxed text-sm border-t border-neutral-100 pt-4">
                {faq.a}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</MainLayout>

<script>
  // Utility function for Rupiah formatting
  function formatRupiah(angka) {
    let number_string = angka.toString().replace(/[^,\d]/g, '');
    let split = number_string.split(',');
    let sisa = split[0].length % 3;
    let rupiah = split[0].substr(0, sisa);
    let ribuan = split[0].substr(sisa).match(/\d{3}/gi);

    if (ribuan) {
      let separator = sisa ? '.' : '';
      rupiah += separator + ribuan.join('.');
    }

    return split[1] != undefined ? rupiah + ',' + split[1] : rupiah;
  }

  // Handle Input Masking for Rupiah
  const inputSetoran = document.getElementById('setoran_perbulan') as HTMLInputElement;
  if(inputSetoran) {
    inputSetoran.addEventListener('input', function(e) {
      this.value = formatRupiah(this.value);
    });
  }

  // Calculator Logic
  const btnHitung = document.getElementById('btnHitung');
  const resultArea = document.getElementById('resultArea');
  
  if (btnHitung && resultArea) {
    btnHitung.addEventListener('click', () => {
      const paketTargetStr = (document.getElementById('paket_target') as HTMLSelectElement).value;
      const jumlahJamaahStr = (document.getElementById('jumlah_jamaah') as HTMLSelectElement).value;
      const setoranStr = (document.getElementById('setoran_perbulan') as HTMLInputElement).value;
      
      const paketPrice = parseInt(paketTargetStr, 10);
      const jamaah = parseInt(jumlahJamaahStr, 10);
      const setoran = parseInt(setoranStr.replace(/\./g, ''), 10);
      
      if(isNaN(setoran) || setoran < 100000) {
        alert("Mohon masukkan nominal setoran yang valid (Min. Rp 100.000)");
        return;
      }

      // Calculations
      const totalBiaya = paketPrice * jamaah;
      const durasiBulan = Math.ceil(totalBiaya / setoran);
      
      // Calculate Dates
      const currentDate = new Date();
      const futureDate = new Date(currentDate.setMonth(currentDate.getMonth() + durasiBulan));
      const tahunBerangkat = futureDate.getFullYear();
      const bulanBerangkat = futureDate.toLocaleString('id-ID', { month: 'long' });

      // Update UI
      document.getElementById('resTotal')!.textContent = `Rp ${formatRupiah(totalBiaya)}`;
      
      const tahunLama = Math.floor(durasiBulan / 12);
      const sisaBulan = durasiBulan % 12;
      let durasiText = '';
      if(tahunLama > 0) durasiText += `${tahunLama} Tahun `;
      if(sisaBulan > 0) durasiText += `${sisaBulan} Bulan`;
      if(tahunLama === 0 && sisaBulan === 0) durasiText = '1 Bulan'; // fallback
      
      document.getElementById('resDurasi')!.textContent = durasiText.trim();
      document.getElementById('resTahun')!.textContent = `${bulanBerangkat} ${tahunBerangkat}`;
      
      // Show Result
      resultArea.classList.remove('hidden');
      resultArea.classList.add('animate-fade-in-up');
    });
  }

  // FAQ Accordion Logic
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(item => {
    const btn = item.querySelector('.faq-btn');
    const answer = item.querySelector('.faq-answer') as HTMLElement;
    const icon = item.querySelector('.faq-icon');
    
    if(btn && answer && icon) {
      btn.addEventListener('click', () => {
        const isOpen = item.classList.contains('active');
        
        // Close all
        faqItems.forEach(otherItem => {
          otherItem.classList.remove('active');
          const otherAns = otherItem.querySelector('.faq-answer') as HTMLElement;
          const otherIcon = otherItem.querySelector('.faq-icon');
          if(otherAns) otherAns.style.maxHeight = '0px';
          if(otherIcon) otherIcon.classList.remove('rotate-180');
        });
        
        // Open clicked if it wasn't open
        if (!isOpen) {
          item.classList.add('active');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          icon.classList.add('rotate-180');
        }
      });
    }
  });
</script>
