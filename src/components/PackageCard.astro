---
import { MapPin, Plane, Star } from '@lucide/astro';

interface Props {
  pkg: {
    id?: number;
    slug?: string;
    badge: string; // e.g., "9 HARI" or "REGULER"
    duration?: string; // fallback if badge is used for something else
    type?: string; 
    title: string;
    price: string;
    airline: string;
    hotel: string;
    date: string;
    seats: number;
    bg?: string; // fallback
    image?: string; // new prop for real image
    mekkahDist?: string; // e.g., "± 700m"
    madinahDist?: string; // e.g., "± 500m"
    isRecommended?: boolean;
  };
  delay?: number;
}

const { pkg, delay = 0 } = Astro.props;

// Fallback image if not provided
const coverImage = pkg.image || 'https://images.unsplash.com/photo-1565552645632-d725e8bfc19a?auto=format&fit=crop&q=80&w=800';
---

<a href={`/paket/${pkg.slug || pkg.id || '#'}`} class="bg-white rounded-[1.5rem] p-3 border border-neutral-200 shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-xl transition-all duration-300 flex flex-col group animate-fade-in-up" data-type={pkg.type} style={`animation-delay: ${delay}ms;`}>
  <!-- Image Header -->
  <div class="h-32 sm:h-40 relative overflow-hidden rounded-xl mb-4">
    <img src={coverImage} alt={pkg.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
    
    <!-- Duration Badge (Top Left) -->
    <div class={`absolute top-3 left-3 text-white text-[10px] sm:text-xs font-bold px-3 py-1.5 rounded uppercase tracking-wider shadow-sm ${pkg.badge.includes('9') ? 'bg-[#0a1930]' : 'bg-[#c39336]'}`}>
      {pkg.badge}
    </div>

    <!-- Recommended Badge (Top Right) -->
    {pkg.isRecommended && (
      <div class="absolute top-0 right-0 bg-[#c39336] text-white text-[9px] sm:text-[10px] font-bold px-3 py-1 rounded-bl-lg uppercase tracking-wider shadow-sm">
        Rekomendasi
      </div>
    )}
  </div>
  
  <!-- Content Body -->
  <div class="px-1 flex-1 flex flex-col">
    <h3 class="text-base sm:text-lg font-bold text-[#0a1930] mb-0.5 leading-tight truncate">{pkg.title}</h3>
    <p class="text-[11px] sm:text-xs text-slate-500 mb-5 truncate">Hotel {pkg.hotel}</p>
    
    <!-- Info Grid -->
    <div class="flex items-center justify-between mb-6">
      <!-- Mekkah -->
      <div class="flex flex-col gap-0.5">
        <div class="flex items-center gap-1.5">
          <MapPin class="w-3.5 h-3.5 text-[#c39336]" />
          <span class="text-[10px] font-bold text-[#0a1930]">Mekkah</span>
        </div>
        <span class="text-[10px] text-slate-500 pl-5">{pkg.mekkahDist || '± 300m'}</span>
      </div>
      
      <!-- Madinah -->
      <div class="flex flex-col gap-0.5">
        <div class="flex items-center gap-1.5">
          <MapPin class="w-3.5 h-3.5 text-[#c39336]" />
          <span class="text-[10px] font-bold text-[#0a1930]">Madinah</span>
        </div>
        <span class="text-[10px] text-slate-500 pl-5">{pkg.madinahDist || '± 200m'}</span>
      </div>
      
      <!-- Pesawat -->
      <div class="flex flex-col gap-0.5">
        <div class="flex items-center gap-1.5">
          <Plane class="w-3.5 h-3.5 text-[#c39336]" />
          <span class="text-[10px] font-bold text-[#0a1930]">Pesawat</span>
        </div>
        <span class="text-[10px] text-slate-500 pl-5 truncate w-16 sm:w-20">{pkg.airline}</span>
      </div>
    </div>
    
    <!-- Price & CTA Button -->
    <div class="mt-auto flex items-end justify-between">
      <div>
        <div class="text-[10px] font-medium text-[#0a1930] mb-1">Mulai dari</div>
        <div class="text-base sm:text-lg font-black text-[#0a1930] leading-none">Rp {pkg.price}</div>
      </div>
      
      <div class={`font-bold py-2 px-4 rounded-xl transition-colors text-[10px] sm:text-xs shrink-0 flex items-center justify-center ${pkg.title.includes('Ekonomis') ? 'bg-transparent border border-[#0a1930] text-[#0a1930] group-hover:bg-[#0a1930] group-hover:text-white' : 'bg-[#c39336] text-white group-hover:bg-[#a87d2b]'}`}>
        Booking
      </div>
    </div>
  </div>
</a>
