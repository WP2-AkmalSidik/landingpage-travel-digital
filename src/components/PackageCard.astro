---
import { Plane, Building, Calendar, MessageCircle } from '@lucide/astro';

interface Props {
  pkg: {
    badge: string;
    type?: string; // Umrah or Haji (for paket.astro)
    title: string;
    price: string;
    airline: string;
    hotel: string;
    date: string;
    seats: number;
    bg: string;
  };
  delay?: number;
}

const { pkg, delay = 0 } = Astro.props;
---

<div class="pkg-card bg-white rounded-2xl sm:rounded-3xl overflow-hidden border border-neutral-200 shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-2xl transition-all duration-300 flex flex-col group animate-fade-in-up" data-type={pkg.type} style={`animation-delay: ${delay}ms;`}>
  <!-- Header/Image placeholder -->
  <div class={`h-32 sm:h-48 relative ${pkg.bg} flex items-center justify-center overflow-hidden`}>
    <div class="absolute inset-0 opacity-30 mix-blend-overlay bg-[url('/images/hero-bg.png')] bg-cover bg-center"></div>
    
    <div class="absolute top-2 left-2 sm:top-4 sm:left-4 bg-white/20 backdrop-blur-md text-white text-[10px] sm:text-xs font-bold px-2 py-0.5 sm:px-3 sm:py-1 rounded-full uppercase tracking-wider border border-white/30">
      {pkg.badge}
    </div>
    
    <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-slate-900 to-transparent"></div>
  </div>
  
  <!-- Content -->
  <div class="p-3 sm:p-6 flex-1 flex flex-col">
    <h3 class="text-sm sm:text-xl font-bold text-slate-900 mb-2 sm:mb-4 leading-tight truncate">{pkg.title}</h3>
    
    <div class="space-y-1.5 sm:space-y-3 mb-4 sm:mb-6 flex-1">
      <div class="flex items-center gap-1.5 sm:gap-3 text-[10px] sm:text-sm text-slate-600">
        <Plane class="w-3 h-3 sm:w-4 sm:h-4 text-primary shrink-0" /> <span class="truncate">{pkg.airline}</span>
      </div>
      <div class="flex items-center gap-1.5 sm:gap-3 text-[10px] sm:text-sm text-slate-600">
        <Building class="w-3 h-3 sm:w-4 sm:h-4 text-primary shrink-0" /> <span class="truncate">Hotel {pkg.hotel}</span>
      </div>
      <div class="flex items-center gap-1.5 sm:gap-3 text-[10px] sm:text-sm text-slate-600">
        <Calendar class="w-3 h-3 sm:w-4 sm:h-4 text-primary shrink-0" /> <span class="truncate">{pkg.date}</span>
      </div>
    </div>
    
    <div class="pt-2 sm:pt-4 border-t border-neutral-100 flex flex-col sm:flex-row sm:items-center sm:justify-between mb-3 sm:mb-6 gap-2 sm:gap-0">
      <div>
        <div class="text-[9px] sm:text-xs text-slate-500 mb-0.5">Mulai dari</div>
        <div class="text-sm sm:text-lg font-black text-slate-900 leading-none">Rp {pkg.price}</div>
      </div>
      <div class="text-[9px] sm:text-xs font-semibold text-orange-600 bg-orange-50 px-1.5 py-0.5 sm:px-2 sm:py-1 rounded inline-block text-center w-fit">
        Sisa {pkg.seats} Kursi
      </div>
    </div>
    
    <div class="grid grid-cols-2 gap-2 sm:gap-3 mt-auto">
      <button onclick={`openModal('${pkg.title}', '${pkg.price}', '${pkg.airline}', '${pkg.hotel}', '${pkg.date}')`} class="w-full text-center bg-slate-900 text-white hover:bg-slate-800 font-bold py-2 sm:py-3 rounded-lg sm:rounded-xl transition-all hover:shadow-lg hover:-translate-y-0.5 text-[10px] sm:text-sm">
        Detail
      </button>
      <a href={`https://wa.me/6281234567890?text=Halo%20PaKeM%20Tours,%20saya%20tertarik%20dengan%20${encodeURIComponent(pkg.title)}`} target="_blank" class="w-full flex items-center justify-center gap-1 sm:gap-2 bg-[#25D366] text-white hover:bg-[#128C7E] font-bold py-2 sm:py-3 rounded-lg sm:rounded-xl transition-all hover:shadow-lg hover:-translate-y-0.5 text-[10px] sm:text-sm">
        <MessageCircle class="w-3 h-3 sm:w-4 sm:h-4 shrink-0" /> 
        <span class="sm:hidden">WA</span>
        <span class="hidden sm:inline">Tanya CS</span>
      </a>
    </div>
  </div>
</div>
