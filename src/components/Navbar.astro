---
import { Globe, Menu, X, MessageCircle } from '@lucide/astro';

const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Beranda', href: '/#beranda' },
  { name: 'Tentang Kami', href: '/tentang-kami' },
  { name: 'Paket Umroh', href: '/paket-umroh' },
  { name: 'Paket Haji', href: '/paket-haji' },
  { name: 'Tabungan', href: '/tabungan' }
];
---

<header id="navbar" class="hidden lg:block fixed top-0 left-0 w-full z-50 transition-all duration-300 border-b border-transparent">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-slate-900 group bg-white/95 backdrop-blur-sm px-3 py-1 sm:px-4 sm:py-1.5 rounded-full shadow-lg hover:shadow-xl transition-all border border-white/20">
        <img src="/images/logo-pakem.png" alt="PaKeM Tours Logo" class="h-9 sm:h-10 w-auto" />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-8">
        <ul class="flex items-center gap-6">
          {navLinks.map(link => {
            // Logic for active state
            let isActive = false;
            if (currentPath === '/') {
              isActive = link.name === 'Beranda';
            } else {
              // Ignore hash links on other pages, only match actual paths like /paket
              isActive = !link.href.startsWith('/#') && currentPath.startsWith(link.href);
            }
            
            return (
              <li>
                <a 
                  href={link.href} 
                  class={`desktop-link text-sm font-medium transition-colors relative group py-2 ${isActive ? 'text-gold' : 'text-neutral-200 hover:text-gold'}`}
                >
                  {link.name}
                  <span class={`indicator absolute bottom-0 left-0 h-0.5 bg-gold transition-all duration-300 ${isActive ? 'w-full' : 'w-0 group-hover:w-full'}`}></span>
                </a>
              </li>
            )
          })}
        </ul>
        <div class="flex items-center gap-3">
          <a href="/#konsultasi" class="bg-slate-900 text-white text-sm font-bold px-4 py-2 rounded-full transition-transform hover:-translate-y-0.5 shadow-lg flex items-center gap-2">
            <div class="bg-white/10 p-1.5 rounded-full">
              <MessageCircle class="w-4 h-4" />
            </div>
            <div class="flex flex-col text-left leading-none">
              <span class="text-[10px] font-medium text-neutral-300">Konsultasi Gratis</span>
              <span class="text-xs">0812-3456-7890</span>
            </div>
          </a>
          <a href="/register" class="bg-gradient-to-r from-gold to-gold-light hover:from-gold-light hover:to-gold text-white text-sm font-bold px-6 py-3 rounded-full transition-transform hover:-translate-y-0.5 shadow-lg hover:shadow-gold/30">
            Daftar Sekarang
          </a>
        </div>
      </nav>

      <!-- Mobile view: we only show logo, nav moved to bottom -->
      <div class="lg:hidden w-10"></div> <!-- spacer for flex-between balance -->
</header>

<script>
  // Navbar scroll effect
  const navbar = document.getElementById('navbar');
  const menu = document.getElementById('mobile-menu');
  
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar.classList.add('bg-primary/95', 'backdrop-blur-md', 'shadow-lg', 'border-white/10');
      navbar.classList.remove('border-transparent');
    } else {
      if (window.scrollY <= 20) {
        navbar.classList.remove('bg-primary/95', 'backdrop-blur-md', 'shadow-lg', 'border-white/10');
        navbar.classList.add('border-transparent');
      }
    }
  });


</script>
