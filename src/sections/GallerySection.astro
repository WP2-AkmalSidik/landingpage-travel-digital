---
const gallery = [
  {
    title: 'Keberangkatan Jamaah',
    desc: 'Momen pelepasan jamaah ke Tanah Suci',
    image: '/images/gallery_berangkat_1780650761908.png'
  },
  {
    title: 'Perjalanan Nyaman',
    desc: 'Perjalanan aman bersama maskapai terbaik',
    image: '/images/gallery_nyaman_1780650774300.png'
  },
  {
    title: 'Akomodasi Terbaik',
    desc: 'Hotel nyaman dekat Masjidil Haram/Nabawi',
    image: '/images/gallery_hotel_1780650786322.png'
  },
  {
    title: 'Pembimbingan Ibadah',
    desc: 'Pembimbingan komprehensif selama ibadah',
    image: '/images/gallery_bimbing_1780650798094.png'
  }
];
---

<section class="py-16 md:py-24 bg-neutral-50">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {gallery.map((item) => (
        <div class="bg-white rounded-3xl overflow-hidden shadow-[0_4px_20px_rgb(0,0,0,0.03)] border border-neutral-100 group">
          <div class="h-48 overflow-hidden relative">
            <div class="absolute inset-0 bg-slate-900/20 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
            <img src={item.image} alt={item.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
          </div>
          <div class="p-6">
            <h3 class="text-lg font-bold text-slate-900 mb-2">{item.title}</h3>
            <p class="text-sm text-slate-500">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
