---
import { Plane, Building, Calendar, ArrowRight, MessageCircle, X } from '@lucide/astro';
import PackageCard from '../components/PackageCard.astro';

const packages = [
  {
    badge: 'REGULER',
    title: 'Umrah Reguler 9 Hari',
    price: '30.800.000',
    airline: 'Saudi Airlines',
    hotel: 'Bintang 4',
    date: '12 Juni 2024',
    seats: 12,
    bg: 'bg-gradient-to-br from-blue-900 to-primary'
  },
  {
    badge: 'PLUS TURKI',
    title: 'Umrah Plus Turki 12 Hari',
    price: '39.800.000',
    airline: 'Turkish Airlines',
    hotel: 'Bintang 5',
    date: '20 Juli 2024',
    seats: 7,
    bg: 'bg-gradient-to-br from-orange-600 to-gold'
  },
  {
    badge: 'RAMADHAN',
    title: 'Umrah Ramadhan 12 Hari',
    price: '42.500.000',
    airline: 'Saudi Airlines',
    hotel: 'Bintang 5',
    date: '5 Maret 2024',
    seats: 10,
    bg: 'bg-gradient-to-br from-purple-900 to-slate-900'
  },
  {
    badge: 'HAJI KHUSUS',
    title: 'Haji Khusus 24 Hari',
    price: '135.000.000',
    airline: 'Garuda Indonesia',
    hotel: 'Bintang 5',
    date: '10 Mei 2024',
    seats: 5,
    bg: 'bg-gradient-to-br from-emerald-900 to-slate-900'
  }
];
---

<section id="paket" class="py-24 bg-neutral-50 border-t border-neutral-200">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16 animate-fade-in-up">
      <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-4">
        Pilihan Paket <span class="text-primary">Umrah & Haji</span>
      </h2>
      <p class="text-lg text-slate-600">
        Pilih paket yang sesuai dengan kebutuhan dan jadwal Anda. Kenyamanan ibadah adalah prioritas kami.
      </p>
    </div>

    <!-- Responsive Grid Layout -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 max-w-7xl mx-auto px-2 sm:px-0">
      {packages.map((pkg, i) => (
        <PackageCard pkg={pkg} delay={i * 100} />
      ))}
    </div>
    
    <div class="text-center mt-8">
      <a href="/paket" class="inline-flex items-center gap-2 text-primary hover:text-gold font-bold transition-colors">
        Lihat Semua Paket <ArrowRight class="w-4 h-4" />
      </a>
    </div>
  </div>

  <!-- Modal Detail Paket (Home) -->
  <dialog id="paketModal" class="backdrop:bg-slate-900/80 bg-transparent p-4 w-full max-w-lg m-auto rounded-3xl shadow-2xl opacity-0 pointer-events-none transition-opacity duration-300">
    <div id="homeModalContent" class="bg-white rounded-3xl overflow-hidden relative shadow-2xl transform scale-95 transition-transform duration-300">
      <!-- Close Button -->
      <button onclick="closeModal()" class="absolute top-4 right-4 z-10 w-8 h-8 flex items-center justify-center bg-white/20 backdrop-blur-md rounded-full text-white hover:bg-white/40 transition-colors">
        <X class="w-5 h-5" />
      </button>
      
      <!-- Header -->
      <div class="bg-gradient-to-br from-slate-900 to-primary p-6 pt-10 text-center relative overflow-hidden">
        <div class="absolute inset-0 opacity-20 mix-blend-overlay bg-[url('/images/hero-bg.png')] bg-cover bg-center"></div>
        <h3 id="homeModalTitle" class="text-2xl font-bold text-white relative z-10">Judul Paket</h3>
      </div>
      
      <!-- Content -->
      <div class="p-6">
        <div class="space-y-4 mb-8 bg-neutral-50 p-5 rounded-2xl border border-neutral-100">
          <div class="flex items-center gap-4 text-slate-700">
            <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center shrink-0">
              <Plane class="w-5 h-5 text-primary" />
            </div>
            <div>
              <div class="text-xs text-slate-500">Maskapai</div>
              <div id="homeModalAirline" class="font-semibold text-slate-900">Maskapai</div>
            </div>
          </div>
          <div class="flex items-center gap-4 text-slate-700">
            <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center shrink-0">
              <Building class="w-5 h-5 text-primary" />
            </div>
            <div>
              <div class="text-xs text-slate-500">Akomodasi</div>
              <div id="homeModalHotel" class="font-semibold text-slate-900">Hotel</div>
            </div>
          </div>
          <div class="flex items-center gap-4 text-slate-700">
            <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center shrink-0">
              <Calendar class="w-5 h-5 text-primary" />
            </div>
            <div>
              <div class="text-xs text-slate-500">Jadwal Keberangkatan</div>
              <div id="homeModalDate" class="font-semibold text-slate-900">Tanggal</div>
            </div>
          </div>
        </div>
        
        <div class="flex flex-col items-center justify-center mb-6">
          <div class="text-sm text-slate-500 mb-1">Harga Mulai Dari</div>
          <div id="homeModalPrice" class="text-3xl font-black text-slate-900">Rp 0</div>
        </div>
        
        <a id="homeModalWaLink" href="#" target="_blank" class="w-full flex items-center justify-center gap-2 bg-green-600 text-white hover:bg-green-700 font-bold py-3.5 rounded-xl transition-all shadow-md hover:shadow-lg">
          <MessageCircle class="w-5 h-5" /> Konsultasi via WhatsApp
        </a>
      </div>
    </div>
  </dialog>
</section>

<script is:inline>
  const hModal = document.getElementById('paketModal');
  const hModalContent = document.getElementById('homeModalContent');
  
  function openModal(title, price, airline, hotel, date) {
    document.getElementById('homeModalTitle').innerText = title;
    document.getElementById('homeModalPrice').innerText = 'Rp ' + price;
    document.getElementById('homeModalAirline').innerText = airline;
    document.getElementById('homeModalHotel').innerText = 'Hotel ' + hotel;
    document.getElementById('homeModalDate').innerText = date;
    document.getElementById('homeModalWaLink').href = `https://wa.me/6281234567890?text=Halo%20PaKeM%20Tours,%20saya%20tertarik%20dengan%20${encodeURIComponent(title)}%20dan%20ingin%20berkonsultasi.`;
    
    hModal.showModal();
    // Fade in
    setTimeout(() => {
      hModal.classList.remove('opacity-0', 'pointer-events-none');
      hModal.classList.add('opacity-100', 'pointer-events-auto');
      hModalContent.classList.remove('scale-95');
      hModalContent.classList.add('scale-100');
    }, 10);
  }
  
  function closeModal() {
    hModal.classList.add('opacity-0', 'pointer-events-none');
    hModal.classList.remove('opacity-100', 'pointer-events-auto');
    hModalContent.classList.add('scale-95');
    hModalContent.classList.remove('scale-100');
    setTimeout(() => {
      hModal.close();
    }, 300);
  }

  // Close on backdrop click
  if (hModal) {
    hModal.addEventListener('click', (e) => {
      const dialogDimensions = hModal.getBoundingClientRect();
      if (
        e.clientX < dialogDimensions.left ||
        e.clientX > dialogDimensions.right ||
        e.clientY < dialogDimensions.top ||
        e.clientY > dialogDimensions.bottom
      ) {
        closeModal();
      }
    });
  }
</script>

<style>
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  @keyframes fadeInUp {
    to { opacity: 1; transform: translateY(0); }
  }
</style>
