---
import { Plane, Building, Calendar, ArrowRight } from '@lucide/astro';

const packages = [
  {
    badge: 'REGULER',
    title: 'Umrah Reguler 9 Hari',
    price: '30.800.000',
    airline: 'Saudi Airlines',
    hotel: 'Bintang 4',
    date: '12 Juni 2024',
    seats: 12,
    bg: 'bg-gradient-to-br from-blue-900 to-primary'
  },
  {
    badge: 'PLUS TURKI',
    title: 'Umrah Plus Turki 12 Hari',
    price: '39.800.000',
    airline: 'Turkish Airlines',
    hotel: 'Bintang 5',
    date: '20 Juli 2024',
    seats: 7,
    bg: 'bg-gradient-to-br from-orange-600 to-gold'
  },
  {
    badge: 'RAMADHAN',
    title: 'Umrah Ramadhan 12 Hari',
    price: '42.500.000',
    airline: 'Saudi Airlines',
    hotel: 'Bintang 5',
    date: '5 Maret 2024',
    seats: 10,
    bg: 'bg-gradient-to-br from-purple-900 to-slate-900'
  },
  {
    badge: 'HAJI KHUSUS',
    title: 'Haji Khusus 24 Hari',
    price: '135.000.000',
    airline: 'Garuda Indonesia',
    hotel: 'Bintang 5',
    date: '10 Mei 2024',
    seats: 5,
    bg: 'bg-gradient-to-br from-emerald-900 to-slate-900'
  }
];
---

<section id="paket" class="py-24 bg-neutral-50 border-t border-neutral-200">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16 animate-fade-in-up">
      <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-4">
        Pilihan Paket <span class="text-primary">Terbaik</span>
      </h2>
      <p class="text-lg text-slate-600">
        Pilih paket yang sesuai dengan kebutuhan dan jadwal Anda. Kenyamanan ibadah adalah prioritas kami.
      </p>
    </div>

    <!-- Responsive Grid Layout -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 max-w-7xl mx-auto px-2 sm:px-0">
      {packages.map((pkg, i) => (
        <div class="bg-white rounded-2xl sm:rounded-3xl overflow-hidden border border-neutral-200 shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-2xl transition-all duration-300 flex flex-col group animate-fade-in-up" style={`animation-delay: ${i * 100}ms;`}>
          <!-- Header/Image placeholder (using gradient) -->
          <div class={`h-32 sm:h-48 relative ${pkg.bg} flex items-center justify-center overflow-hidden`}>
            <div class="absolute inset-0 opacity-30 mix-blend-overlay bg-[url('/images/hero-bg.png')] bg-cover bg-center"></div>
            <div class="absolute top-2 left-2 sm:top-4 sm:left-4 bg-white/20 backdrop-blur-md text-white text-[10px] sm:text-xs font-bold px-2 py-0.5 sm:px-3 sm:py-1 rounded-full uppercase tracking-wider border border-white/30">
              {pkg.badge}
            </div>
            <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-slate-900 to-transparent"></div>
          </div>
          
          <!-- Content -->
          <div class="p-3 sm:p-6 flex-1 flex flex-col">
            <h3 class="text-sm sm:text-xl font-bold text-slate-900 mb-2 sm:mb-4 leading-tight truncate">{pkg.title}</h3>
            
            <div class="space-y-1.5 sm:space-y-3 mb-4 sm:mb-6 flex-1">
              <div class="flex items-center gap-1.5 sm:gap-3 text-[10px] sm:text-sm text-slate-600">
                <Plane class="w-3 h-3 sm:w-4 sm:h-4 text-neutral-400 shrink-0" /> <span class="truncate">{pkg.airline}</span>
              </div>
              <div class="flex items-center gap-1.5 sm:gap-3 text-[10px] sm:text-sm text-slate-600">
                <Building class="w-3 h-3 sm:w-4 sm:h-4 text-neutral-400 shrink-0" /> <span class="truncate">Hotel {pkg.hotel}</span>
              </div>
              <div class="flex items-center gap-1.5 sm:gap-3 text-[10px] sm:text-sm text-slate-600">
                <Calendar class="w-3 h-3 sm:w-4 sm:h-4 text-neutral-400 shrink-0" /> <span class="truncate">{pkg.date}</span>
              </div>
            </div>
            
            <div class="pt-2 sm:pt-4 border-t border-neutral-100 flex flex-col sm:flex-row sm:items-center sm:justify-between mb-3 sm:mb-6 gap-2 sm:gap-0">
              <div>
                <div class="text-[9px] sm:text-xs text-slate-500 mb-0.5">Mulai dari</div>
                <div class="text-sm sm:text-lg font-black text-slate-900 leading-none">Rp {pkg.price}</div>
              </div>
              <div class="text-[9px] sm:text-xs font-semibold text-orange-600 bg-orange-50 px-1.5 py-0.5 sm:px-2 sm:py-1 rounded inline-block text-center w-fit">
                Sisa {pkg.seats} Kursi
              </div>
            </div>
            
            <a href="#pesan" class="block w-full text-center bg-slate-900 text-white hover:bg-primary font-bold py-2 sm:py-3 rounded-lg sm:rounded-xl transition-colors mt-auto text-xs sm:text-base">
              Detail
            </a>
          </div>
        </div>
      ))}
    </div>
    
    <div class="text-center mt-8">
      <a href="#semua-paket" class="inline-flex items-center gap-2 text-primary hover:text-gold font-bold transition-colors">
        Lihat Semua Paket <ArrowRight class="w-4 h-4" />
      </a>
    </div>
  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  @keyframes fadeInUp {
    to { opacity: 1; transform: translateY(0); }
  }
</style>
