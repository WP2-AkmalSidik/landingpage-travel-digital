---
import { Star } from '@lucide/astro';

const testimonials = [
  {
    name: 'Ibu Siti Aisyah',
    role: 'Jamaah Umrah Reguler',
    text: '"Alhamdulillah perjalanan sangat memuaskan, hotelnya dekat sekali dengan masjid. Pembimbing sabar dan sangat membantu untuk lansia seperti saya."',
    rating: 5,
    avatar: 'SA',
    bgColor: 'bg-blue-100',
    textColor: 'text-blue-700'
  },
  {
    name: 'Bapak H. Ahmad',
    role: 'Jamaah Haji Khusus',
    text: '"Pelayanan luar biasa, semua diurus dengan amanah. Saya tidak perlu pusing memikirkan teknis, cukup fokus ibadah saja. Recommended banget!"',
    rating: 5,
    avatar: 'HA',
    bgColor: 'bg-green-100',
    textColor: 'text-green-700'
  },
  {
    name: 'Keluarga Bpk. Ridwan',
    role: 'Jamaah Umrah Plus Turki',
    text: '"Membawa anak-anak umrah ternyata tidak merepotkan berkat bantuan tim PaKeM Tours. Transportasinya VIP, muthawwifnya juga pintar mendongeng sejarah nabi untuk anak-anak."',
    rating: 5,
    avatar: 'KR',
    bgColor: 'bg-orange-100',
    textColor: 'text-orange-700'
  },
  {
    name: 'Ibu Nurhayati',
    role: 'Jamaah Umrah Ramadhan',
    text: '"Luar biasa berkahnya ibadah di bulan Ramadhan bersama PaKeM Tours. Bimbingannya mantap, aplikasinya juga sangat bantu buat cek jadwal dan doa-doa."',
    rating: 5,
    avatar: 'IN',
    bgColor: 'bg-purple-100',
    textColor: 'text-purple-700'
  }
];
---

<section id="testimoni" class="py-24 bg-neutral-50 overflow-hidden relative">
  <!-- Decorative background -->
  <div class="absolute top-0 right-0 w-1/3 h-1/2 bg-gradient-to-b from-primary/5 to-transparent blur-3xl pointer-events-none rounded-bl-full"></div>
  
  <div class="container mx-auto px-4 max-w-7xl relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16 animate-fade-in-up">
      <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">
        Apa Kata <span class="text-gold">Jamaah Kami?</span>
      </h2>
      <p class="text-lg text-slate-600">
        Ribuan jamaah telah mempercayakan perjalanan sucinya bersama kami. Berikut adalah pengalaman tulus dari mereka.
      </p>
    </div>

    <!-- Masonry-like modern Bento Grid -->
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
      {testimonials.map((testi, i) => (
        <div class="bg-white rounded-3xl p-8 border border-neutral-100 shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_20px_40px_rgb(0,0,0,0.08)] hover:-translate-y-1 transition-all duration-300 relative animate-fade-in-up" style={`animation-delay: ${i * 100}ms;`}>
          <!-- Quote Icon decoration -->
          <div class="absolute top-6 right-8 text-neutral-100 opacity-50">
            <svg class="w-16 h-16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path></svg>
          </div>
          
          <div class="flex items-center gap-1 mb-6">
            {[...Array(testi.rating)].map(() => (
              <Star class="w-5 h-5 text-gold fill-gold" />
            ))}
          </div>
          
          <p class="text-lg md:text-xl text-slate-700 leading-relaxed mb-8 relative z-10 font-medium italic">
            {testi.text}
          </p>
          
          <div class="flex items-center gap-4 mt-auto">
            <div class={`w-12 h-12 rounded-full flex items-center justify-center font-bold text-lg ${testi.bgColor} ${testi.textColor}`}>
              {testi.avatar}
            </div>
            <div>
              <div class="font-bold text-slate-900">{testi.name}</div>
              <div class="text-sm text-slate-500">{testi.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  @keyframes fadeInUp {
    to { opacity: 1; transform: translateY(0); }
  }
</style>
