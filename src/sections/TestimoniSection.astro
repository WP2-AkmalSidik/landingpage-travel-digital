---
import { Play, Star, Users, Plane, Building, Headphones } from '@lucide/astro';

const testimonials = [
  {
    name: 'Ibu Siti Aisyah',
    role: 'Jamaah Umrah Reguler',
    text: '"Alhamdulillah perjalanan sangat lancar, hotel nyaman, pembimbing sabar dan sangat membantu."',
    image: '/images/testi_aisyah_1780650748272.png'
  },
  {
    name: 'Bapak H. Mahfud',
    role: 'Jamaah Haji Khusus',
    text: '"Pelayanan luar biasa, semua diurus dengan amanah. Recommended banget!"',
    image: '/images/team_ali_1780650701188.png' // Using Ali's portrait as a placeholder
  }
];

const stats = [
  { value: '31+', label: 'Tahun Pengalaman', icon: Users },
  { value: '50.000+', label: 'Jamaah Berangkat', icon: Users },
  { value: '1000+', label: 'Keberangkatan', icon: Plane },
  { value: '150+', label: 'Hotel Rekanan', icon: Building },
  { value: '24/7', label: 'Layanan Jamaah', icon: Headphones },
];
---

<section id="testimoni" class="py-20 bg-white">
  <div class="container mx-auto px-4 max-w-7xl">
    
    <!-- Top Part: Testimonials & Video -->
    <div class="bg-[#f4f7fc] rounded-[2rem] p-6 lg:p-10 mb-8 border border-blue-50/50 shadow-sm">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left: Text content -->
        <div class="lg:col-span-3">
          <h3 class="text-[11px] font-bold text-[#0a1930] uppercase tracking-wider mb-2">Testimoni Jamaah</h3>
          <h2 class="text-2xl md:text-3xl font-bold text-[#0a1930] leading-tight mb-4">
            Kepuasan Jamaah Prioritas Kami
          </h2>
          <p class="text-sm text-slate-600 mb-8 leading-relaxed">
            Alhamdulillah, ribuan jamaah telah berangkat bersama PAKEM TOURS dengan pelayanan terbaik dan penuh amanah.
          </p>
          <a href="#testimoni-full" class="inline-block px-6 py-2.5 rounded-lg border-2 border-[#0a1930]/20 text-[#0a1930] font-semibold text-sm hover:bg-[#0a1930] hover:text-white transition-colors">
            Lihat Semua Testimoni
          </a>
        </div>

        <!-- Middle: Video Thumbnail -->
        <div class="lg:col-span-6 relative group cursor-pointer h-[250px] sm:h-[300px] lg:h-full min-h-[300px]">
          <div class="absolute inset-0 rounded-2xl overflow-hidden shadow-md">
            <img src="/images/video-thumbnail-jamaah.png" alt="Video Testimoni" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors"></div>
          </div>
          
          <!-- Play Button -->
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-16 h-16 bg-white rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
            <Play class="w-6 h-6 text-[#0a1930] ml-1 fill-[#0a1930]" />
          </div>
          
          <!-- Duration -->
          <div class="absolute bottom-4 left-4 bg-black/70 text-white text-xs font-medium px-2.5 py-1 rounded-md backdrop-blur-sm">
            02:45
          </div>
        </div>

        <!-- Right: Testimonial Cards -->
        <div class="lg:col-span-3 flex flex-col gap-4">
          {testimonials.map((testi) => (
            <div class="bg-white rounded-xl p-5 shadow-sm border border-neutral-100">
              <div class="flex items-center gap-3 mb-3">
                <img src={testi.image} alt={testi.name} class="w-10 h-10 rounded-full object-cover" />
                <div>
                  <h4 class="font-bold text-[#0a1930] text-xs">{testi.name}</h4>
                  <p class="text-[10px] text-slate-500">{testi.role}</p>
                </div>
              </div>
              <p class="text-[11px] text-slate-600 leading-relaxed mb-3 italic">
                {testi.text}
              </p>
              <div class="flex gap-1">
                {[1,2,3,4,5].map(() => (
                  <Star class="w-3.5 h-3.5 text-gold fill-gold" />
                ))}
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>

    <!-- Bottom Part: Stats Bar -->
    <div class="bg-[#0a1930] rounded-2xl p-6 lg:p-8 shadow-xl">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-y-8 gap-x-4 divide-x-0 lg:divide-x divide-white/10">
        {stats.map((stat, index) => (
          <div class={`flex items-center justify-center gap-4 ${index !== 0 ? 'lg:pl-4' : ''}`}>
            <stat.icon class="w-8 h-8 text-white/80 shrink-0" stroke-width="1.5" />
            <div class="flex flex-col">
              <span class="text-xl lg:text-2xl font-bold text-white leading-tight">{stat.value}</span>
              <span class="text-[10px] sm:text-xs text-neutral-300">{stat.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
