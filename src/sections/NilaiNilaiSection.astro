---
import { ShieldCheck, Briefcase, Heart, Users, Lightbulb } from '@lucide/astro';

const values = [
  {
    icon: ShieldCheck,
    title: 'Amanah',
    desc: 'Menjaga kepercayaan jamaah dengan penuh tanggung jawab.',
  },
  {
    icon: Briefcase,
    title: 'Profesional',
    desc: 'Didukung oleh tim berpengalaman dan sistem kerja yang terstruktur.',
  },
  {
    icon: Heart,
    title: 'Nyaman',
    desc: 'Memberikan fasilitas terbaik untuk perjalanan ibadah yang nyaman.',
  },
  {
    icon: Users,
    title: 'Keluarga',
    desc: 'Melayani seluruh jamaah layaknya keluarga sendiri dengan penuh perhatian.',
  },
  {
    icon: Lightbulb,
    title: 'Inovatif',
    desc: 'Terus berinovasi dalam teknologi untuk pelayanan lebih baik.',
  }
];
---

<section class="py-16 md:py-20 bg-neutral-50 border-t border-neutral-100">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">Nilai-Nilai Kami</h2>
      <div class="w-20 h-1 bg-gold mx-auto rounded-full"></div>
    </div>
    
    <div class="flex flex-wrap justify-center gap-4 lg:gap-6">
      {values.map((val) => (
        <div class="bg-white rounded-[2rem] p-5 lg:p-6 border border-neutral-100 shadow-[0_8px_30px_rgb(0,0,0,0.04)] w-full sm:w-[calc(50%-16px)] md:w-[calc(33.333%-16px)] flex items-center gap-4 group hover:-translate-y-2 transition-transform duration-300">
          <div class="w-14 h-14 shrink-0 rounded-full bg-slate-800 text-white flex items-center justify-center group-hover:bg-gold transition-colors duration-300">
            <val.icon class="w-6 h-6" />
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-900 mb-1">{val.title}</h3>
            <p class="text-[11px] lg:text-xs text-slate-500 leading-relaxed">{val.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
