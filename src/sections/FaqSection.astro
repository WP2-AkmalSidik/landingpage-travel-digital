---
import { ChevronDown } from '@lucide/astro';

const faqs = [
  {
    q: 'Apakah PaKeM Tours sudah memiliki izin resmi?',
    a: 'Ya, PaKeM Tours adalah Penyelenggara Perjalanan Ibadah Umrah (PPIU) resmi yang terdaftar di Kementerian Agama RI dengan rekam jejak lebih dari 31 tahun.'
  },
  {
    q: 'Bagaimana cara mendaftar paket umrah?',
    a: 'Anda bisa langsung menekan tombol "Konsultasi Gratis" di website ini yang akan mengarahkan Anda ke WhatsApp Customer Service kami. Tim kami akan memandu proses pendaftaran dari awal hingga selesai.'
  },
  {
    q: 'Apakah ada fasilitas cicilan atau tabungan?',
    a: 'Tentu. Kami menyediakan program Tabungan Umroh yang fleksibel dan bebas riba untuk membantu Anda merencanakan perjalanan suci dengan lebih mudah tanpa beban finansial berat.'
  },
  {
    q: 'Bagaimana jika saya belum pernah umrah sama sekali?',
    a: 'Jangan khawatir! Anda akan mendapatkan akses ke Aplikasi Manasik Digital kami dan bimbingan langsung dari Ustadz pembimbing mulai dari persiapan di tanah air, selama di tanah suci, hingga kembali ke rumah.'
  }
];
---

<section id="faq" class="py-24 bg-white">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">Pertanyaan Umum (FAQ)</h2>
      <p class="text-lg text-slate-600">Temukan jawaban atas pertanyaan yang sering diajukan calon jamaah.</p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, i) => (
        <details class="group bg-neutral-50 border border-neutral-200 rounded-2xl overflow-hidden animate-fade-in-up transition-shadow duration-300 hover:shadow-md" style={`animation-delay: ${i * 100}ms;`}>
          <summary class="flex justify-between items-center font-bold text-slate-900 p-6 cursor-pointer list-none text-lg">
            {faq.q}
            <span class="transition-transform duration-300 group-open:rotate-180 bg-white shadow-sm p-1 rounded-full">
              <ChevronDown class="w-5 h-5 text-primary" />
            </span>
          </summary>
          <div class="p-6 pt-0 text-slate-600 text-base leading-relaxed border-t border-neutral-100 mt-2">
            {faq.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  @keyframes fadeInUp {
    to { opacity: 1; transform: translateY(0); }
  }
</style>
