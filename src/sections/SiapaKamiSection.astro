---
import { Users, CalendarDays, Award, ThumbsUp } from '@lucide/astro';
---

<section class="py-20 md:py-28 bg-white">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center">
      
      <!-- Image Column -->
      <div class="w-full lg:w-5/12 relative">
        <div class="absolute -inset-4 bg-primary/5 rounded-[3rem] transform -rotate-3 z-0"></div>
        <div class="absolute -inset-4 bg-gold/10 rounded-[3rem] transform rotate-3 z-0"></div>
        <div class="relative z-10 rounded-[2.5rem] overflow-hidden shadow-2xl">
          <img 
            src="/images/tentang_siapa_masjid_1780650599182.png" 
            alt="Masjid Nabawi" 
            class="w-full h-auto object-cover"
          />
        </div>
      </div>

      <!-- Text Column -->
      <div class="w-full lg:w-7/12">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Siapa Kami?</h2>
        
        <div class="space-y-4 text-slate-600 mb-10 leading-relaxed">
          <p>
            Pakem Tours adalah Penyelenggara Perjalanan Ibadah Umrah dan Haji Khusus yang berizin resmi dari Kementerian Agama Republik Indonesia.
          </p>
          <p>
            Sejak berdiri, kami terus berkomitmen memberikan pengalaman ibadah yang nyaman, aman, dan berkesan bagi setiap jamaah.
          </p>
          <p>
            Dengan tim profesional, pembimbing berpengalaman, dan layanan terintegrasi, kami siap menjadi bagian dari perjalanan spiritual Anda.
          </p>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
          
          <div class="bg-neutral-50 rounded-2xl p-5 text-center border border-neutral-100 shadow-[0_4px_20px_rgb(0,0,0,0.02)] group hover:-translate-y-1 transition-transform duration-300">
            <div class="w-12 h-12 mx-auto rounded-full bg-blue-50 text-primary flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
              <Users class="w-6 h-6" />
            </div>
            <div class="font-bold text-slate-900 text-lg mb-1">10.000+</div>
            <div class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Jamaah Berangkat</div>
            <div class="h-[1px] w-8 bg-neutral-200 mx-auto mb-2"></div>
            <p class="text-[9px] text-slate-400">Telah memberangkatkan jamaah ke Tanah Suci</p>
          </div>

          <div class="bg-neutral-50 rounded-2xl p-5 text-center border border-neutral-100 shadow-[0_4px_20px_rgb(0,0,0,0.02)] group hover:-translate-y-1 transition-transform duration-300">
            <div class="w-12 h-12 mx-auto rounded-full bg-gold/10 text-gold flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
              <CalendarDays class="w-6 h-6" />
            </div>
            <div class="font-bold text-slate-900 text-lg mb-1">12+</div>
            <div class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Tahun Pengalaman</div>
            <div class="h-[1px] w-8 bg-neutral-200 mx-auto mb-2"></div>
            <p class="text-[9px] text-slate-400">Berpengalaman melayani jamaah dengan amanah</p>
          </div>

          <div class="bg-neutral-50 rounded-2xl p-5 text-center border border-neutral-100 shadow-[0_4px_20px_rgb(0,0,0,0.02)] group hover:-translate-y-1 transition-transform duration-300">
            <div class="w-12 h-12 mx-auto rounded-full bg-blue-50 text-primary flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
              <Award class="w-6 h-6" />
            </div>
            <div class="font-bold text-slate-900 text-lg mb-1">Izin Resmi</div>
            <div class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Kemenag RI</div>
            <div class="h-[1px] w-8 bg-neutral-200 mx-auto mb-2"></div>
            <p class="text-[9px] text-slate-400">PPIU Resmi No. U.123 Tahun 2020</p>
          </div>

          <div class="bg-neutral-50 rounded-2xl p-5 text-center border border-neutral-100 shadow-[0_4px_20px_rgb(0,0,0,0.02)] group hover:-translate-y-1 transition-transform duration-300">
            <div class="w-12 h-12 mx-auto rounded-full bg-gold/10 text-gold flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
              <ThumbsUp class="w-6 h-6" />
            </div>
            <div class="font-bold text-slate-900 text-lg mb-1">100%</div>
            <div class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Komitmen Layanan</div>
            <div class="h-[1px] w-8 bg-neutral-200 mx-auto mb-2"></div>
            <p class="text-[9px] text-slate-400">Memberikan pelayanan terbaik untuk jamaah</p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
