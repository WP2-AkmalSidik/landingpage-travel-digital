---
import { ChevronLeft, ChevronRight, Star } from '@lucide/astro';

const team = [
  {
    name: 'Ust. Ahmad Fauzi',
    role: 'Pembimbing Ibadah',
    image: '/images/team_fauzi_1780650667950.png'
  },
  {
    name: 'Ust. Muhammad Ali',
    role: 'Pembimbing Ibadah',
    image: '/images/team_ali_1780650701188.png'
  },
  {
    name: 'H. Abdul Karim',
    role: 'Direktur Utama',
    image: '/images/team_karim_1780650713373.png'
  },
  {
    name: 'Rina Marlina',
    role: 'Customer Care',
    image: '/images/team_rina_1780650726706.png'
  }
];
---

<section class="py-16 md:py-24 bg-white">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Tim Profesional (Left Side, 7 columns) -->
      <div class="lg:col-span-7">
        <div class="mb-10">
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">Tim Profesional & Berpengalaman</h2>
          <p class="text-slate-600">Kami didukung oleh tim yang kompeten di bidangnya dan pembimbing ibadah bersertifikat.</p>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {team.map((member) => (
            <div class="bg-white border border-neutral-100 rounded-2xl p-4 shadow-[0_4px_20px_rgb(0,0,0,0.03)] group flex flex-col items-center hover:-translate-y-1 transition-transform duration-300">
              <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden mb-4 border-[3px] border-neutral-50 shadow-sm group-hover:border-gold transition-colors duration-300 bg-neutral-100">
                <img src={member.image} alt={member.name} class="w-full h-full object-cover object-top group-hover:scale-110 transition-transform duration-500" />
              </div>
              <h3 class="text-xs sm:text-sm font-bold text-slate-900 mb-1 text-center">{member.name}</h3>
              <p class="text-[9px] sm:text-[10px] text-slate-500 text-center">{member.role}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Testimoni (Right Side, 5 columns) -->
      <div class="lg:col-span-5">
        <div class="bg-neutral-50 rounded-[2rem] p-6 md:p-8 border border-neutral-100 shadow-[0_4px_20px_rgb(0,0,0,0.02)] relative">
          
          <div class="flex items-center justify-between gap-3 sm:gap-6">
            <!-- Left Arrow -->
            <button class="w-8 h-8 rounded-full bg-white border border-neutral-200 flex items-center justify-center text-slate-400 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0 shadow-sm">
              <ChevronLeft class="w-4 h-4" />
            </button>
            
            <!-- Content -->
            <div class="flex-1">
              <h3 class="text-lg md:text-xl font-bold text-slate-900 mb-4">Apa Kata Jamaah Kami</h3>
              
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
                Pelayanan sangat memuaskan, dari berangkat sampai pulang semuanya diurus dengan baik. Pembimbingnya juga sabar dan ilmunya sangat bermanfaat.
              </p>
              
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-full overflow-hidden bg-neutral-200">
                    <img src="/images/testi_aisyah_1780650748272.png" alt="Siti Aisyah" class="w-full h-full object-cover" />
                  </div>
                  <div>
                    <h4 class="font-bold text-slate-900 text-sm">Siti Aisyah</h4>
                    <p class="text-[10px] text-slate-500">Jamaah Umrah Januari 2024</p>
                  </div>
                </div>
                
                <div class="flex gap-1">
                  {[1,2,3,4,5].map(() => (
                    <Star class="w-3.5 h-3.5 text-gold fill-gold" />
                  ))}
                </div>
              </div>
            </div>
            
            <!-- Right Arrow -->
            <button class="w-8 h-8 rounded-full bg-white border border-neutral-200 flex items-center justify-center text-slate-400 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0">
              <ChevronRight class="w-4 h-4" />
            </button>
          </div>
          
        </div>
      </div>

    </div>
  </div>
</section>
